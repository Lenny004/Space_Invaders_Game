          <SubComponents>
            <Component class="javax.swing.JTextArea" name="TAPuBalas">
              <Properties>
                <Property name="columns" type="int" value="20"/>
                <Property name="rows" type="int" value="5"/>
                <Property name="text" type="java.lang.String" value="1.La parte Superior con &#xa;letras rojas, en esta&#xa;seccion nos dan&#xa;una mejora en la &#xa;cantidad de balas&#xa;que puede disparar&#xa;la nave.&#xa;&#xa;Esta ordenado de forma&#xa;ascendente, siendo Fe&#xa;el compuesto mas&#xa;debil.&#xa;&#xa;Esta mejora es &#xa;permanente "/>
              </Properties>
            </Component>
          </SubComponents>
        </Container>
