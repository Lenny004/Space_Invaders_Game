          <SubComponents>
            <Component class="javax.swing.JTextArea" name="TAPuVelocidad">
              <Properties>
                <Property name="columns" type="int" value="20"/>
                <Property name="rows" type="int" value="5"/>
                <Property name="text" type="java.lang.String" value="3.La parte Inferior con&#xa;letras Moradas, es la&#xa;seccion para mejorar&#xa;la velocidad de la&#xa;nave.&#xa;&#xa;Esta ordenado de forma&#xa;ascendente, siendo He&#xa;el compuesto mas&#xa;debil.&#xa;&#xa;Esta mejora no es &#xa;permanente"/>
              </Properties>
            </Component>
          </SubComponents>
        </Container>
